# Copy to .env.local and fill in values from Supabase -> Project Settings -> API.
# Never commit real values. .env* files are ignored by Git (except this one).

# Public: safe to expose to the browser (RLS gives anonymous users no data access).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret: server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: secret used to hash client IPs for registration rate limiting.
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset. Any long random string works.
RATE_LIMIT_SECRET=
